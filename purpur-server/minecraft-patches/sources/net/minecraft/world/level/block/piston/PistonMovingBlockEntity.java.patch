+    private static void moveCollidedEntitiesWithAsyncMath(
+        final BlockPos pos,
+        final Direction movement,
+        final double deltaProgress,
+        final PistonMovingBlockEntity self,
+        final List<AABB> shapeAabbs,
+        final boolean causeBounce,
+        final List<Entity> entities
+    ) {
+        List<AABB> movedShapeAabbs = new ArrayList<>(shapeAabbs.size());
+        for (AABB shapeAabb : shapeAabbs) {
+            movedShapeAabbs.add(moveByPositionAndProgress(pos, shapeAabb, self));
+        }
+
+        List<PistonEntitySnapshot> snapshots = new ArrayList<>(entities.size());
+        for (Entity entity : entities) {
+            if (entity.getPistonPushReaction() == PushReaction.IGNORE || causeBounce && entity instanceof ServerPlayer) {
+                continue;
+            }
+
+            snapshots.add(
+                new PistonEntitySnapshot(
+                    entity,
+                    entity.getBoundingBox(),
+                    causeBounce ? getPistonBounceDelta(entity, movement) : null
+                )
+            );
+        }
+
+        List<PistonEntityMove> moves = ASYNC_PISTON_COLLISION_EXECUTOR.submit(
+            () -> snapshots.parallelStream()
+                .map(snapshot -> computePistonEntityMove(snapshot, movedShapeAabbs, movement, deltaProgress))
+                .filter(Objects::nonNull)
+                .toList()
+        ).join();
+
+        for (PistonEntityMove move : moves) {
+            Entity entity = move.entity();
+            Vec3 bounceDelta = move.bounceDelta();
+            if (bounceDelta != null) {
+                entity.setDeltaMovement(bounceDelta);
+                // Paper - EAR items stuck in slime pushed by a piston
+                entity.activatedTick = Math.max(entity.activatedTick, net.minecraft.server.MinecraftServer.currentTick + 10);
+                entity.activatedImmunityTick = Math.max(entity.activatedImmunityTick, net.minecraft.server.MinecraftServer.currentTick + 10);
+                // Paper end
+            }
+
+            double delta = move.delta();
+            if (!(delta <= 0.0)) {
+                delta = Math.min(delta, deltaProgress) + 0.01;
+                moveEntityByPiston(movement, entity, delta, movement);
+                if (!self.extending && self.isSourcePiston) {
+                    fixEntityWithinPistonBase(pos, entity, movement, deltaProgress);
+                }
+            }
+        }
+    }
+
+    private static Vec3 getPistonBounceDelta(final Entity entity, final Direction movement) {
+        Vec3 deltaMovement = entity.getDeltaMovement();
+        double dx = deltaMovement.x;
+        double dy = deltaMovement.y;
+        double dz = deltaMovement.z;
+        switch (movement.getAxis()) {
+            case X:
+                dx = movement.getStepX();
+                break;
+            case Y:
+                dy = movement.getStepY();
+                break;
+            case Z:
+                dz = movement.getStepZ();
+        }
+
+        return new Vec3(dx, dy, dz);
+    }
+
+    private static PistonEntityMove computePistonEntityMove(
+        final PistonEntitySnapshot snapshot,
+        final List<AABB> shapeAabbs,
+        final Direction movement,
+        final double deltaProgress
+    ) {
+        double delta = 0.0;
+
+        for (AABB shapeAabb : shapeAabbs) {
+            AABB movingAABB = PistonMath.getMovementArea(shapeAabb, movement, deltaProgress);
+            AABB entityAabb = snapshot.entityAabb();
+            if (movingAABB.intersects(entityAabb)) {
+                delta = Math.max(delta, getMovement(movingAABB, movement, entityAabb));
+                if (delta >= deltaProgress) {
+                    break;
+                }
+            }
+        }
+
+        return delta <= 0.0 && snapshot.bounceDelta() == null ? null : new PistonEntityMove(snapshot.entity(), delta, snapshot.bounceDelta());
+    }
