@@ -248,6 +248,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     protected final Services services;
     private long lastServerStatus;
     public final Thread serverThread;
+    // Purpur start - Region-based Multi-threading fields
+    private org.purpurmc.purpur.threading.MultiThreadedTicker multiThreadedTicker;
+    public org.purpurmc.purpur.threading.MultiThreadedTicker getMultiThreadedTicker() { return this.multiThreadedTicker; }
+    // Purpur end - Region-based Multi-threading fields
     private long lastTickNanos = Util.getNanos();
     private long taskExecutionStartNanos = Util.getNanos();
     private long idleTimeNanos;
@@ -999,6 +1003,12 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         LOGGER.info("Stopping server");
         Commands.COMMAND_SENDING_POOL.shutdownNow(); // Paper - Perf: Async command map building; Shutdown and don't bother finishing
+        // Purpur start - Region-based Multi-threading shutdown
+        if (this.multiThreadedTicker != null) {
+            this.multiThreadedTicker.shutdown();
+            this.multiThreadedTicker = null;
+        }
+        // Purpur end - Region-based Multi-threading shutdown
         // Purpur start - UPnP Port Forwarding
         if (upnp) {
             if (dev.omega24.upnp4j.UPnP4J.close(this.getPort(), dev.omega24.upnp4j.util.Protocol.TCP)) {
@@ -1223,6 +1233,18 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             }
             // Purpur end - config for startup commands
 
+            // Purpur start - Region-based Multi-threading initialization
+            org.purpurmc.purpur.threading.ThreadContext.initialize(Thread.currentThread());
+            if (org.purpurmc.purpur.PurpurConfig.multiThreadingEnabled) {
+                this.multiThreadedTicker = new org.purpurmc.purpur.threading.MultiThreadedTicker(
+                    org.purpurmc.purpur.PurpurConfig.regionThreadCount
+                );
+                this.multiThreadedTicker.setEnabled(true);
+                LOGGER.info("[Purpur] Region-based multi-threading initialized with {} threads",
+                    this.multiThreadedTicker.getThreadCount());
+            }
+            // Purpur end - Region-based Multi-threading initialization
+
             while (this.running) {
                 long l;
                 if (!this.isPaused() && this.tickRateManager.isSprinting() && this.tickRateManager.checkShouldSprintThisTick()) {
@@ -1740,34 +1762,53 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
-        for (ServerLevel serverLevel : this.getAllLevels()) {
-            serverLevel.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
-            serverLevel.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
-            serverLevel.updateLagCompensationTick(); // Paper - lag compensation
-            net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = serverLevel.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
