+    // Purpur start - Region-based Multi-threading
+    private org.purpurmc.purpur.threading.RegionContext regionContext;
+    public org.purpurmc.purpur.threading.RegionContext getRegionContext() {
+        if (this.regionContext == null) {
+            this.regionContext = new org.purpurmc.purpur.threading.RegionContext(this);
