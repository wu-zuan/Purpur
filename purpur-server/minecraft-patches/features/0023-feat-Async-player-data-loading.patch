                 optional.ifPresent(serverPlayer::load);
                 // CraftBukkit start - Better rename detection
                 if (optional.isPresent()) {
@@ -319,6 +352,22 @@ public class PrepareSpawnTask implements ConfigurationTask {
         }
     }
 
-    sealed interface State permits PrepareSpawnTask.Preparing, PrepareSpawnTask.Ready {
+    final class LoadingData implements PrepareSpawnTask.State {
+        private final CompletableFuture<Optional<net.minecraft.nbt.CompoundTag>> dataFuture;
+
+        LoadingData(CompletableFuture<Optional<net.minecraft.nbt.CompoundTag>> dataFuture) {
+            this.dataFuture = dataFuture;
+        }
+
+        public Optional<net.minecraft.nbt.CompoundTag> get() {
+            return this.dataFuture.join();
+        }
+
+        public boolean isDone() {
+            return this.dataFuture.isDone();
+        }
+    }
+
+    sealed interface State permits PrepareSpawnTask.LoadingData, PrepareSpawnTask.Preparing, PrepareSpawnTask.Ready {
     }
